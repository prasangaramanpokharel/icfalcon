#!/usr/bin/env bash
set -euo pipefail

# falcon — IcFalcon ops CLI

resolve_cli_root() {
  local source="${BASH_SOURCE[0]}"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ "$source" != /* ]] && source="$dir/$source"
  done
  cd "$(dirname "$source")/.." && pwd
}

CLI_ROOT="$(resolve_cli_root)"

resolve_project_root() {
  local cur="$PWD"
  while [[ "$cur" != "/" && -n "$cur" ]]; do
    if [[ -f "$cur/falcon.yaml" ]]; then
      echo "$cur"
      return 0
    fi
    cur="$(dirname "$cur")"
  done
  echo "$CLI_ROOT"
}

ROOT="${FALCON_ROOT:-$(resolve_project_root)}"
CONFIG="${FALCON_CONFIG:-$ROOT/falcon.yaml}"
BACKEND_DIR="$ROOT/$(grep -E '^backend_dir:' "$CONFIG" 2>/dev/null | head -1 | sed 's/backend_dir: *//' || echo backend)"

if [[ -t 1 ]]; then
  RED=$'\033[0;31m'
  GREEN=$'\033[0;32m'
  CYAN=$'\033[0;36m'
  DIM=$'\033[2m'
  NC=$'\033[0m'
else
  RED=''
  GREEN=''
  CYAN=''
  DIM=''
  NC=''
fi
BANNER_FILE="$CLI_ROOT/ops/cmd/prefixAscii.txt"
[[ -f "$BANNER_FILE" ]] || BANNER_FILE="$ROOT/ops/cmd/prefixAscii.txt"

print_banner() {
  [[ -f "$BANNER_FILE" ]] || return 0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    printf '%s%s%s\n' "$CYAN" "$line" "$NC"
  done < "$BANNER_FILE"
}

usage() {
  print_banner
  printf '%sInternet Computer app framework%s\n\n' "$DIM" "$NC"
  cat <<EOF
Usage:
  falcon <command> [--local] [args...]

${GREEN}Setup${NC}
  s:init          Full local setup + dev server
  r:start         Start local replica
  r:stop          Stop local replica

${GREEN}Backend${NC}
  b:test          Run unit tests + build canister
  b:build         Build canister
  b:deploy        Build + deploy (upgrade)
  b:hash          Module hash / canister info
  b:logs          Canister logs

${GREEN}Production${NC}
  p:check         Validate skills + build backend + frontend
  p:ship          Deploy backend + build frontend

${GREEN}Audit${NC} ${DIM}(black/flake8 style)${NC}
  audit code:motoko   Audit Motoko code style, layering & syntax
  a:c:m               Short alias

${GREEN}Skills${NC}
  sk:validate     Validate .agent/skills structure (CI)

${GREEN}Canister${NC}
  c:status        Canister status
  c:ping          Health ping
  c:list          List canister IDs
  c:id            Show canister ID
  c:info          Full canister info
  c:create        Create canister on network
  c:start         Start canister
  c:stop          Stop canister
  c:delete        Delete canister
  c:metadata      Read metadata section (candid, moc:version)
  c:settings      Inspect or update canister settings
  c:sync          Synchronize bindings / assets
  c:call <method> [args] [--update]

${GREEN}Identity${NC}
  id:whoami       Show current selected identity (whoami)
  id:p            Show principal of current identity (id:principal)
  id:addr         Show account identifier (id:address)
  id:ls           List all identities (id:list)
  id:use <name>   Switch active identity
  id:new <name>   Create new identity
  id:export       Export identity PEM
  id:import       Import identity PEM

${GREEN}Token (ICP & ICRC)${NC}
  t:bal [token]   Check token balance (default: icp)
  t:send <dest> <amt>  Transfer tokens
  t:approve <spender> <amt>  ICRC-2 token approval
  t:allowance <spender>      ICRC-2 allowance check

${GREEN}Cycles${NC}
  y:bal           Cycles balance
  y:mint <amount> Convert ICP to cycles
  y:topup [amt]   Top up canister with cycles (c:topup)
  y:fund [icp]    Fund identity with ICP for cycles (shows QR code)
  y:send <dest>   Transfer cycles
  y:addr          Cycles ledger address

${GREEN}Network & Project${NC}
  net:ls          List configured networks
  net:status      Show network status
  net:ping        Ping local network
  prj:show        Show effective project config (icp.yaml)
  env:ls          List environments (local, ic)

${GREEN}Users${NC}
  u:count         User + feature counts (status)

${GREEN}Frontend${NC}
  f:dev           Next.js dev server
  f:build         Static export build
  f:production    Serve static production build (npx serve@latest out)
  f:prod          Short alias

${GREEN}Packages${NC} ${DIM}(like go get)${NC}
  add pkg <name>    Install package from icp-hub
  a:p <name>        Short alias
  package:<name>    Install by name (falcon package:slug)
  p:list            List hub packages
  p:ls              List installed packages
  p:push <name>     Publish local pkg to hub

${GREEN}Scaffold${NC}
  m:f <Name>        Create full module in main canister (Order, Product, …)
  m:feature <Name>
  m:c <Name>        Scaffold standalone micro-canister (Trade, Vault, …)
  m:canister <Name>   with Falcon Universe mesh wiring

Examples:
  falcon s:init
  falcon r:start
  falcon m:f Order
  falcon m:c Trade
  falcon b:deploy --canister trade --local
  falcon b:test --local
  falcon p:ship --local
  falcon c:call status --local
  falcon c:call createOrder '("hello")' --update --local

Install global: ./ops/install.sh
EOF
}

step() { printf '\n%s▸%s %s\n' "$GREEN" "$NC" "$1"; }
fail() { printf '%serror:%s %s\n' "$RED" "$NC" "$1" >&2; exit 1; }

yaml_value() {
  local key="$1"
  grep -E "^${key}:" "$CONFIG" | head -1 | sed -E "s/^${key}:[[:space:]]*//" | tr -d '"'
}

yaml_alias_target() {
  local alias="$1"
  awk -v alias="$alias" '
    $0 ~ /^aliases:/ { in_aliases=1; next }
    in_aliases && /^[^ ]/ { in_aliases=0 }
    in_aliases && $1 == alias ":" { print $2; exit }
  ' "$CONFIG"
}

yaml_command_field() {
  local command="$1"
  local field="$2"
  awk -v command="$command" -v field="$field" '
    $0 ~ "^  " command ":" { in_cmd=1; next }
    in_cmd && /^  [^ ]/ { exit }
    in_cmd && $1 == field ":" {
      line=$0
      sub(/^[^:]*:[[:space:]]*/, "", line)
      print line
      exit
    }
  ' "$CONFIG"
}

yaml_command_steps() {
  local command="$1"
  awk -v command="$command" '
    $0 ~ "^  " command ":" { in_cmd=1; in_steps=0; next }
    in_cmd && /^  [^ ]/ { exit }
    in_cmd && /^    steps:/ { in_steps=1; next }
    in_steps && /^      - / {
      line=$0
      sub(/^      - /, "", line)
      print line
    }
    in_steps && /^    [^ ]/ && $1 != "-" { in_steps=0 }
  ' "$CONFIG"
}

confirm_mainnet() {
  if [[ ! -t 0 ]]; then
    fail "mainnet write blocked without TTY"
  fi
  read -r -p "Continue on mainnet? [y/N] " answer
  [[ "$answer" == "y" || "$answer" == "Y" ]] || fail "cancelled"
}

expand_template() {
  local line="$1"
  local network="$2"
  local canister="${FALCON_CANISTER:-$(yaml_value canister)}"
  line="${line//\{\{canister\}\}/$canister}"
  line="${line//\{\{network\}\}/$network}"
  printf '%s' "$line"
}

resolve_command() {
  local command="$1"
  local alias_target
  alias_target="$(yaml_alias_target "$command" || true)"
  if [[ -n "$alias_target" ]]; then
    echo "$alias_target"
  else
    echo "$command"
  fi
}

run_command() {
  local command="$1"
  local network_flag="$2"
  shift 2
  local extra_args=("$@")

  local resolved
  resolved="$(resolve_command "$command")"

  local confirm
  confirm="$(yaml_command_field "$resolved" confirm || true)"
  if [[ "$confirm" == "true" && "$network_flag" != "--network local" ]]; then
    confirm_mainnet
  fi

  local script
  script="$(yaml_command_field "$resolved" script || true)"

  local network_label="mainnet"
  [[ "$network_flag" == "--network local" ]] && network_label="local"
  case "$resolved" in
    setup:init|replica:start|replica:stop) network_label="local" ;;
  esac
  print_banner
  step "$resolved ($network_label)"

  export FALCON_ROOT="$ROOT"
  export FALCON_BACKEND_DIR="$BACKEND_DIR"
  export FALCON_CANISTER="${FALCON_CANISTER:-$(yaml_value canister)}"
  export FALCON_NETWORK="$network_flag"

  if command -v mops >/dev/null 2>&1; then
    local moc_bin
    moc_bin="$(mops toolchain bin moc 2>/dev/null || true)"
    if [[ -n "$moc_bin" && -x "$moc_bin" ]]; then
      local moc_dir
      moc_dir="$(dirname "$moc_bin")"
      export PATH="$moc_dir:$PATH"
      export DFX_MOC_PATH="$moc_bin"
      ln -sf "$moc_bin" "$moc_dir/moc-wrapper" 2>/dev/null || true
    fi
  fi

  export DFX_WARNING="${DFX_WARNING:--mainnet_plaintext_identity}"

  if [[ -n "$script" ]]; then
    local script_bin="${script%% *}"
    local script_default_args=""
    if [[ "$script" == *" "* ]]; then
      script_default_args="${script#* }"
    fi
    local script_path="$ROOT/$script_bin"
    if [[ ! -f "$script_path" && -f "$CLI_ROOT/$script_bin" ]]; then
      script_path="$CLI_ROOT/$script_bin"
    fi
    [[ -x "$script_path" || -f "$script_path" ]] || fail "script not found: $script_path"
    chmod +x "$script_path" 2>/dev/null || true
    if [[ -n "$script_default_args" ]]; then
      bash "$script_path" $script_default_args ${extra_args[@]+"${extra_args[@]}"}
    else
      bash "$script_path" ${extra_args[@]+"${extra_args[@]}"}
    fi
    return
  fi

  local steps
  steps="$(yaml_command_steps "$resolved")"
  [[ -n "$steps" ]] || fail "unknown command: $command (try: falcon help)"

  local workdir="$ROOT"
  if [[ "$resolved" == backend:* || "$resolved" == canister:* || "$resolved" == cycles:* || "$resolved" == users:* ]]; then
    workdir="$BACKEND_DIR"
    [[ -d "$workdir" ]] || fail "backend dir not found: $workdir"
  fi

  while IFS= read -r step_line; do
    [[ -z "$step_line" ]] && continue
    local cmd
    cmd="$(expand_template "$step_line" "$network_flag")"
    if [[ "${FALCON_VERBOSE:-0}" == "1" ]]; then
      printf '  %s%s\n' "$DIM" "$cmd"
    fi
    if [[ "$cmd" == dfx* ]]; then
      (cd "$BACKEND_DIR" && bash -c "$cmd")
    else
      (cd "$workdir" && bash -c "$cmd")
    fi
  done <<< "$steps"
}

main() {
  [[ -f "$CONFIG" ]] || fail "config not found: $CONFIG"

  local command="${1:-}"
  shift || true

  local local_flag=false
  local target_canister=""
  local filtered_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --local)
        local_flag=true
        shift
        ;;
      --canister)
        target_canister="${2:-}"
        shift 2 || shift
        ;;
      --canister=*)
        target_canister="${1#--canister=}"
        shift
        ;;
      *)
        filtered_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ -n "$target_canister" ]]; then
    export FALCON_CANISTER="$target_canister"
  fi

  local network_flag="--network ic"
  if $local_flag; then
    network_flag="--network local"
  fi

  case "$command" in
    ""|help|-h|--help)
      usage
      exit 0
      ;;
    list)
      print_banner
      grep -E '^  [a-z].*:$' "$CONFIG" | sed -E 's/^  ([^:]+):.*/\1/' | grep -v '^aliases$'
      exit 0
      ;;
    add)
      if [[ "${filtered_args[0]:-}" == "pkg" ]]; then
        export FALCON_ROOT="$ROOT"
        export FALCON_BACKEND_DIR="$BACKEND_DIR"
        print_banner
        step "pkg:add"
        local script="$ROOT/ops/pkg-add.sh"
        [[ -f "$script" ]] || script="$CLI_ROOT/ops/pkg-add.sh"
        bash "$script" "${filtered_args[1]:?usage: falcon add pkg <name>}"
        exit 0
      fi
      fail "unknown add command (try: falcon add pkg <name>)"
      ;;
    package:*)
      export FALCON_ROOT="$ROOT"
      export FALCON_BACKEND_DIR="$BACKEND_DIR"
      local pkg_name="${command#package:}"
      print_banner
      step "pkg:add $pkg_name"
      bash "$ROOT/ops/pkg-add.sh" "$pkg_name"
      exit 0
      ;;
    audit)
      if [[ "${filtered_args[0]:-}" == "code:motoko" || "${filtered_args[0]:-}" == "motoko" ]]; then
        command="audit:motoko"
        filtered_args=(${filtered_args[@]+"${filtered_args[@]:1}"})
      else
        command="audit:motoko"
      fi
      ;;
  esac

  run_command "$command" "$network_flag" ${filtered_args[@]+"${filtered_args[@]}"}
}

main "$@"
